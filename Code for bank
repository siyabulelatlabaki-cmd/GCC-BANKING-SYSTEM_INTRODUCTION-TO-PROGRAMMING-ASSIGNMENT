// Login
int login() {
    string account, pin;

    cout << "|============= LOGIN ==============|";
    cout << "Enter Account Number: ";
    cin >> account;

    cout << "Enter PIN: ";
    cin >> pin;

    int index = findUserIndex(account);

    if (index != -1 && pins[index] == pin) {
        cout << "Access Granted! Welcome, " << names[index] << "!\n";
        return index;
    } else {
        cout << "Error: Invalid account number or PIN.";
        return -1;
    }
}

// Helper function to safely read numbers
double getValidAmount() {
    double amount;
    while (!(cin >> amount) || amount <= 0) {
        cout << "Invalid amount. Please enter a positive number: R";
        cin.clear();
        cin.ignore(numeric_limits<streamsize>::max(), ');
    }
    return amount;
}

// Logged-in User Dashboard
void userMenu(int userIndex) {
    int choice = 0;

    while (choice != 5) {
        cout << "|=========== USER MENU ============|";
        cout << "Account: " << accounts[userIndex] << " | Holder: " << names[userIndex] << "";
        cout << "1. Check Balance";
        cout << "2. Deposit Money";
        cout << "3. Withdraw Money";
        cout << "4. Transfer Money";
        cout << "5. Logout";
        cout << "Choose an option: ";

        if (!(cin >> choice)) {
            cout << "Invalid input. Please enter a number between 1 and 5.";
            cin.clear();
            cin.ignore(numeric_limits<streamsize>::max(), '');
            continue;
        }

        if (choice == 1) {
            cout << "Current Balance: R" << balances[userIndex] << "";

        } else if (choice == 2) {
            cout << "Enter amount to deposit: R";
            double amount = getValidAmount();
            balances[userIndex] += amount;
            cout << "Deposit successful! New Balance: R" << balances[userIndex] << "";

        } else if (choice == 3) {
            cout << "Enter amount to withdraw: R";
            double amount = getValidAmount();
            if (amount > balances[userIndex]) {
                cout << "Error: Insufficient funds.";
            } else {
                balances[userIndex] -= amount;
                cout << "Withdrawal successful! New Balance: R" << balances[userIndex] << "";
            }

        } else if (choice == 4) {
            string targetAcc;
            cout << "Enter recipient's Account Number: ";
            cin >> targetAcc;

            int targetIndex = findUserIndex(targetAcc);
            if (targetIndex == -1) {
                cout << "Error: Recipient account not found.";
            } else if (targetIndex == userIndex) {
                cout << "Error: You cannot transfer money to your own account.";
            } else {
                cout << "Enter amount to transfer to " << names[targetIndex] << ": R";
                double amount = getValidAmount();
                if (amount > balances[userIndex]) {
                    cout << "Error: Insufficient funds.";
                } else {
                    balances[userIndex] -= amount;
                    balances[targetIndex] += amount;
                    cout << "Transfer successful! New Balance: R" << balances[userIndex] << "";
                }
            }

        } else if (choice == 5) {
            cout << "Logging out...";
        } else {
            cout << "Invalid option. Please choose 1-5.";
        }
    }
}

// Main Program Loop
int main() {
    int choice = 0;

    while (choice != 3) {
        cout << "|========= WELCOME TO BANK ========|";
        cout << "1. Create Account";
        cout << "2. Login";
        cout << "3. Exit";
        cout << "Choose an option: ";

        if (!(cin >> choice)) {
            cout << "Invalid input. Please enter 1, 2, or 3.";
            cin.clear();
            cin.ignore(numeric_limits<streamsize>::max(), '');
            continue;
        }

        if (choice == 1) {
            createAccount();
        } else if (choice == 2) {
            int loggedInIndex = login();
            if (loggedInIndex != -1) {
                userMenu(loggedInIndex);
            }
        } else if (choice == 3) {
            cout << "Thank you for banking with us. Goodbye!";
        } else {
            cout << "Invalid option. Please choose 1-3.";
        }
    }

    return 0;
}